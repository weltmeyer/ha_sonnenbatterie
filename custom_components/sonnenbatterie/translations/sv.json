    "services": {
        "set_operating_mode": {
            "name": "Sätt driftläge",
            "description": "Ställer in driftläget för Sonnenbatterie",
            "fields": {
                "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "example": "1234567890",
                    "name": "Enhets-ID"
                },
                "mode": {
                    "description": "Driftläge att sätta ('manual', 'automatic', 'timeofuse')",
                    "name": "Driftläge",
                    "example": "automatic"
                }
            }
        },
        "set_operating_mode_num": {
            "name": "Sätt driftläge (numeriskt)",
            "description": "Ställer in det numeriska driftläget för Sonnenbatterie",
            "fields": {
                "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "name": "Enhets-ID",
                    "example": "1234567890"
                },
                "mode": {
                    "description": "Driftläge att sätta ('1', '2', '10')",
                    "name": "Driftläge",
                    "example": "2"
                }
            }
        },
        "charge_battery": {
            "name": "Ladda batteri",
            "description": "Tvingar Sonnenbatterie att ladda med angiven effekt i W",
            "fields": {
                "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "name": "Enhets-ID",
                    "example": "1234567890"
                },
                "power": {
                    "name": "Laddeffekt",
                    "description": "Effekt att ladda Sonnenbatterie med",
                    "example": "1000"
                }
            }
        },
        "discharge_battery": {
            "name": "Ladda ur batteri",
            "description": "Tvingar Sonnenbatterie att ladda ur med angiven effekt",
            "fields": {
                "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "name": "Enhets-ID",
                    "example": "1234567890"
                },
                "power": {
                    "name": "Urladdningseffekt",
                    "description": "Effekt att ladda ur Sonnenbatterie med",
                    "example": "1234"
                }
            }
        },
        "set_battery_reserve": {
            "name": "Sätt reservkapacitet",
            "description": "Ställer in hur stor del av kapaciteten Sonnenbatterie sparar som reserv, i procent av totalen",
            "fields": {
                "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "name": "Enhets-ID",
                    "example": "1234567890"
                },
                "value": {
                    "name": "Sparad reservkapacitet",
                    "description": "Procentandel av totalkapaciteten som ska sparas som reserv",
                    "example": "10"
                }
            }
        },
        "set_config_item": {
            "name": "Sätt en konfigurationsparameter",
            "description": "Tillåter ändring av vissa av Sonnenbatteries driftparametrar",
            "fields": {
                "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "name": "Enhets-ID",
                    "example": "1234567890"
                },
                "item": {
                    "name": "Parameternamn",
                    "description": "Namnet på parametern som ska sättas",
                    "example": "EM_USOC"
                },
                "value": {
                    "name": "Parametervärde",
                    "description": "Värdet parametern ska sättas till. Kan vara ett heltal eller en sträng, beroende på parametern",
                    "example": "10 (int) eller \"[]\" (tom JSON-sträng)"
                }
            }
        },
        "set_tou_schedule": {
            "name": "Sätt laddningsschema",
            "description": "Tillåter inställning av laddningsscheman som gäller när Sonnenbatterie är i Time-of-Use-läge",
            "fields": {
                "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "name": "Enhets-ID",
                    "example": "1234567890"
                },
                "schedule": {
                    "name": "Laddningsfönster",
                    "description": "Ett eller flera laddningsfönster som en sträng innehållande en JSON-array",
                    "example": "[{start:10:00, stop:11:00, threshold_p_max: 20000}]"
                }
            }
        },
        "get_tou_schedule": {
            "name": "Hämta laddningsschema",
            "description": "Returnerar de laddningsscheman som för närvarande finns lagrade i Sonnenbatteries konfiguration",
            "fields": {
                    "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "name": "Enhets-ID",
                    "example": "1234567890"
                }
            }
        },
        "get_battery_reserve": {
            "name": "Hämta batterireserv",
            "description": "Returnerar hur stor andel av kapaciteten Sonnenbatterie sparar som reserv.",
            "fields": {
                "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "name": "Enhets-ID",
                    "example": "1234567890"
                }
            }
        },
        "get_operating_mode": {
            "name": "Hämta driftläge",
            "description": "Returnerar Sonnenbatteries nuvarande driftläge i textform",
            "fields": {
                "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "name": "Enhets-ID",
                    "example": "1234567890"
                }
            }
        },
        "get_operating_mode_num": {
            "name": "Hämta driftläge (numeriskt)",
            "description": "Returnerar Sonnenbatteries nuvarande driftläge i numerisk form",
            "fields": {
                "device_id": {
                    "description": "Home Assistant-ID för målenheten",
                    "name": "Enhets-ID",
                    "example": "1234567890"
                }
            }
        }
    }
